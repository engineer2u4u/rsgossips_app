<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime notification permission (requested by src/lib/push.ts). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!--
          Deep link for the in-app browser used by Stripe Checkout. Chrome
          Custom Tabs won't intercept an HTTPS redirect without App Links,
          so we send Stripe a com.rgossips:// success URL instead. When
          Stripe redirects to that scheme, Android hands the URL off to
          this activity and InAppBrowser.openAuth() resolves with it
          instead of loading a web page.
        -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="com.rgossips" />
        </intent-filter>

        <!--
          Admin invitation deep link — tapping `rgossips://?invited=<handle>`
          from an email/SMS opens the app at the Login screen. React
          Navigation's `linking` config (App.tsx) reads the `invited`
          query param and runs the invitation flow.
        -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="rgossips" />
        </intent-filter>
      </activity>

      <!--
        Push notification appearance.

        Without these, FCM falls back to the launcher icon. Android 5+ draws a
        notification's small icon as a silhouette — alpha only — so a
        full-colour launcher icon arrives as a featureless grey square, which
        is exactly what was showing.

        No default_notification_channel_id on purpose: declaring one whose
        channel the app never creates stops notifications appearing at all.
        FCM's own fallback channel is working today, so leave it be until the
        app creates a channel of its own.
      -->
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_icon"
          android:resource="@drawable/ic_notification" />
      <!--
        tools:replace — react-native-firebase_messaging ships this same
        meta-data pointing at @color/white, and the merger refuses to pick
        between two values. Ours wins: a white tint on a white status-bar
        icon is invisible.
      -->
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_color"
          android:resource="@color/notification_color"
          tools:replace="android:resource" />
    </application>
</manifest>

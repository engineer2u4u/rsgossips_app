# Razorpay (test mode). Stripe plan-/checkout-side runs server-side via
# the stripe-checkout edge function, so only the Razorpay public key id
# is consumed on-device. Six Razorpay plan ids match what the web app
# uses; rebuild after changing any of these (react-native-dotenv inlines
# at build time, not at runtime).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_T0rj3hv8AWWacI
NEXT_PUBLIC_RAZORPAY_PLAN_STARTER_MONTHLY=plan_T0s0k1xBZVPVqV
NEXT_PUBLIC_RAZORPAY_PLAN_STARTER_ANNUAL=plan_T0s0kBViDM3mFb
NEXT_PUBLIC_RAZORPAY_PLAN_PRO_MONTHLY=plan_T0s0kJfs3JAGXC
NEXT_PUBLIC_RAZORPAY_PLAN_PRO_ANNUAL=plan_T0s0kUVazAqxyT
NEXT_PUBLIC_RAZORPAY_PLAN_ELITE_MONTHLY=plan_T0s0kgVMveRvcE
NEXT_PUBLIC_RAZORPAY_PLAN_ELITE_ANNUAL=plan_T0s0kqmNOmiSyj

# Stripe price ids — Checkout itself runs on the hosted Stripe page via
# an in-app browser, so the secret never touches the device. These ids
# resolve to the same prices the web app references and are read on the
# device only to send to stripe-checkout in the request body.

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# RN 0.84 defaults to a PREBUILT (Release-compiled) React Native Core. In a
# Debug build, from-source Fabric components (RNCPicker, RNGestureHandler, …)
# reference debug-only React core symbols (Sealable, ShadowNode::getDebugName,
# BaseViewProps::getDebugProps) that the Release prebuilt never emits — the
# link then fails with "Undefined symbol" for exactly those. Build React core
# from source so the debug flags match across the whole graph. Override by
# exporting RCT_USE_PREBUILT_RNCORE=1 before `pod install` if desired.
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!


linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RGossips' do
  config = use_native_modules!

  # react-native-razorpay 2.3.1 pins razorpay-pod = 1.5.0, whose iOS SDK
  # renders the subscription checkout sheet blank. We relax that pin via
  # patch-package (patches/react-native-razorpay+2.3.1.patch) and force the
  # fixed SDK here. 3.0.0 would upgrade the pin cleanly but its TurboModule
  # codegen breaks the New-Arch Fabric link on RN 0.84 (undefined Sealable /
  # ShadowNode / BaseViewProps), so we stay on the 2.3.1 wrapper.
  pod 'razorpay-pod', '1.5.5'

  # @react-native-firebase (FCM) pulls Swift pods (FirebaseCoreInternal,
  # FirebaseInstallations, …) that import C/ObjC deps which ship no module
  # maps under static libraries — so `pod install` fails with "GoogleUtilities
  # does not define modules". Opt just those deps into module maps. Targeted
  # rather than a global use_modular_headers! so the from-source React core
  # and razorpay pods are left untouched.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
